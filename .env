# Configuração de E-mail para Receber Contatos
# Altere o endereço abaixo para onde deseja que os contatos do formulário sejam enviados:
NOTIFICATION_EMAIL=

# Opcional: Chave de API do Resend para disparo de e-mails em produção (https://resend.com)
RESEND_API_KEY=

# Opcional: Configuração do Supabase (para persistência em banco de dados)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Porta do Servidor
PORT=3000
